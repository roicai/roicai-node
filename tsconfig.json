{
  // The generated runtime is written against TypeScript 7 with lib esnext.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "dom"],
    "types": [],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
