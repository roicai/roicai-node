{
  "name": "roicai",
  "version": "0.1.0",
  "description": "TypeScript and JavaScript client for the ROIC.ai financial data API",
  "license": "MIT",
  "author": "ROIC.ai",
  "homepage": "https://github.com/roicai/roicai-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roicai/roicai-node.git"
  },
  "bugs": {
    "url": "https://github.com/roicai/roicai-node/issues"
  },
  "keywords": [
    "roicai",
    "roic",
    "financial data",
    "stocks",
    "fundamentals",
    "earnings calls",
    "api",
    "sdk"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "scripts/generate.sh",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "node --test test/client.test.mjs test/live.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
