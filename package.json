{
  "name": "roicai",
  "version": "0.1.0",
  "description": "Official Node.js and TypeScript client for the ROIC.ai financial data and stock API: fundamentals, earnings calls, prices",
  "license": "MIT",
  "author": "ROIC.ai",
  "homepage": "https://github.com/roicai/roicai-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roicai/roicai-node.git"
  },
  "bugs": {
    "url": "https://github.com/roicai/roicai-node/issues"
  },
  "keywords": [
    "roicai",
    "stock api",
    "financial data api",
    "stock market api",
    "market data api",
    "stock price api",
    "historical stock data",
    "fundamentals",
    "financial statements",
    "financial ratios",
    "earnings call transcripts",
    "sec filings",
    "typescript",
    "nodejs",
    "sdk"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "scripts/generate.sh",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "node --test test/client.test.mjs test/live.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
